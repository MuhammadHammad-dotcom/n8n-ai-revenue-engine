      "id": "0db508b9-c4c3-4755-b530-39320c1fed7a",
      "name": "Lead Intake Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        112
      ],
      "webhookId": "38237676-d109-4105-b81f-3c3083fed2b9"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this inbound lead.\n\nName: {{ $json.body.name }}\nEmail: {{ $json.body.email }}\nCompany: {{ $json.body.company }}\nStated Budget: {{ $json.body.budget }}\nOperational Challenge: {{ $json.body.challenge }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a Senior AI & Automation Systems Architect for a B2B automation agency.\nGiven a lead, do three things:\n1. BUSINESS NEEDS ANALYSIS: Analyze the operational challenge and identify EXACTLY 2 concrete, custom automation opportunities that would solve it.\n2. LEAD QUALIFICATION & SCORING: Assign a numeric score from 1 to 100 based on budget size and the intent/severity of the challenge. Higher budget and clearer, higher-value pain = higher score.\n3. DYNAMIC SALES PITCH: Write a personalized, professional HTML sales email addressed to the lead by first name. It must contain: a one-paragraph brief analysis of their problem, the 2 proposed automation solutions as a short bulleted list, and a clear call-to-action to book a discovery call using this Calendly link: https://calendly.com/your-agency/discovery-call\nAlways respond ONLY with a JSON object matching the required schema. Do not add commentary outside the JSON."
            }
          ]
        },
        "batching": {}
      },
      "id": "26e38e8b-d476-4aee-b369-4e746963d070",
      "name": "AI Analysis & Pitch",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        224,
        112
      ]
    },
    {
      "parameters": {
        "options": {
          "temperature": 0.4
        }
      },
      "id": "292a96bb-e59c-456c-bd4d-0da15c6ad241",
      "name": "Gemini Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        240,
        352
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "1SbIcCHXYyuF2AYp",
          "name": "Google Gemini(PaLM) Api account 3"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"score\":{\"type\":\"number\",\"description\":\"Lead quality score from 1 to 100 based on budget and intent\"},\"intent_summary\":{\"type\":\"string\",\"description\":\"One sentence summary of the business problem\"},\"opportunities\":{\"type\":\"array\",\"description\":\"Exactly 2 custom automation opportunities\",\"items\":{\"type\":\"object\",\"properties\":{\"title\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"}},\"required\":[\"title\",\"description\"]}},\"pitch_subject\":{\"type\":\"string\",\"description\":\"Personalized email subject line\"},\"pitch_email_html\":{\"type\":\"string\",\"description\":\"Personalized HTML sales email including brief analysis, the 2 solutions, and the Calendly booking link\"}},\"required\":[\"score\",\"intent_summary\",\"opportunities\",\"pitch_subject\",\"pitch_email_html\"]}"
      },
      "id": "b329c11b-600a-4e8f-bbca-84f80949115b",
      "name": "Lead JSON Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        368,
        352
      ]
    },
    {
      "parameters": {
        "jsCode": "const ai = $json.output || {};\nconst body = $('Lead Intake Webhook').item.json.body || {};\n\n// Normalize free-text budget like \"$3,000\", \"3k\", \"1,000 - 2,000\"\nconst raw = String(body.budget || '').toLowerCase().replace(/[, ]/g, '');\nconst kMatch = raw.match(/(\\d+(?:\\.\\d+)?)k/);\nlet budgetValue = 0;\nif (kMatch) {\n  budgetValue = parseFloat(kMatch[1]) * 1000;\n} else {\n  const numMatch = raw.match(/(\\d+(?:\\.\\d+)?)/);\n  budgetValue = numMatch ? parseFloat(numMatch[1]) : 0;\n}\n\nconst qualified = budgetValue >= 1000;\n\nconst opps = Array.isArray(ai.opportunities) ? ai.opportunities : [];\nconst oppText = opps.map(o => o.title + ': ' + o.description).join(' | ');\n\nreturn [{ json: {\n  name: body.name || null,\n  email: body.email || null,\n  company: body.company || null,\n  budget_raw: body.budget || null,\n  budget_value: budgetValue,\n  challenge: body.challenge || null,\n  score: typeof ai.score === 'number' ? ai.score : null,\n  intent_summary: ai.intent_summary || null,\n  opportunities: oppText,\n  pitch_subject: ai.pitch_subject || null,\n  pitch_email_html: ai.pitch_email_html || null,\n  qualified: qualified,\n  status: qualified ? 'QUALIFIED' : 'NURTURE_LATER',\n} }];"
      },
      "id": "ba080f2c-aac5-4b0c-85a2-743ab8ce0960",
      "name": "Evaluate Lead",
      "type": "n8n-nodes-base.code",
