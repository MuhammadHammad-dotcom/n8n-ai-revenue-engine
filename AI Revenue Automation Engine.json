        "sendTo": "mhammadmnaeem28@gmail.com",
        "subject": "=🚨 New Qualified Lead Alert: {{ $('Evaluate Lead').item.json.name || 'New Lead' }}",
        "message": "=<div style=\"font-family: Arial, sans-serif; padding: 20px; border: 1px solid #e0e0e0; border-radius: 8px; max-width: 600px;\">\n  <h2 style=\"color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: 10px;\">🚨 New Qualified Lead Alert</h2>\n  <p style=\"font-size: 15px; color: #555;\">A new lead has just been qualified. Details below:</p>\n  \n  <table style=\"width: 100%; border-collapse: collapse; margin-top: 15px;\">\n    <tr><td style=\"padding: 8px; font-weight: bold; width: 30%;\">Name:</td><td style=\"padding: 8px;\">{{ $('Evaluate Lead').item.json.name }}</td></tr>\n    <tr style=\"background-color: #f9f9f9;\"><td style=\"padding: 8px; font-weight: bold;\">Email:</td><td style=\"padding: 8px;\"><a href=\"mailto:{{ $('Evaluate Lead').item.json.email }}\">{{ $('Evaluate Lead').item.json.email }}</a></td></tr>\n    <tr><td style=\"padding: 8px; font-weight: bold;\">Score:</td><td style=\"padding: 8px;\">{{ $('Evaluate Lead').item.json.score }}/100</td></tr>\n    <tr style=\"background-color: #f9f9f9;\"><td style=\"padding: 8px; font-weight: bold;\">Budget:</td><td style=\"padding: 8px; color: #27ae60; font-weight: bold;\">{{ $('Evaluate Lead').item.json.budget_raw }}</td></tr>\n    <tr><td style=\"padding: 8px; font-weight: bold;\">Message:</td><td style=\"padding: 8px;\">{{ $('Evaluate Lead').item.json.challenge }}</td></tr>\n  </table>\n</div>",
